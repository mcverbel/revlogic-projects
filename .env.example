# Neon: the pooled connection string from your Neon project (Connection Details)
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.us-east-2.aws.neon.tech/revlogic_projects?sslmode=require

# Auth.js — generate with: npx auth secret
AUTH_TRUST_HOST=true
AUTH_SECRET=
# Google OAuth client (Google Cloud Console > APIs & Services > Credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Only these email domains can sign in (comma-separated)
ALLOWED_EMAIL_DOMAINS=rev-logic.com
# Emails that become admins on first sign-in (comma-separated)
ADMIN_EMAILS=maria@rev-logic.com

# Encrypts stored connection tokens. 32+ random characters: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Claude API, used to turn calls, emails and Slack messages into suggested tasks
ANTHROPIC_API_KEY=
# The Claude model id to use (see docs.claude.com/en/docs/about-claude/models)
ANTHROPIC_MODEL=

# Slack app (api.slack.com/apps): bot token for channel reading + notifications
SLACK_BOT_TOKEN=
# Slack user-token OAuth for "My Slack DMs"
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Aurasell MCP sign-in (Aurasell > Settings > MCP Access > "OAuth client ID")
AURASELL_OAUTH_CLIENT_ID=
AURASELL_MCP_URL=https://app.aurasell.ai/mcp
# Link to the scheduled Claude task that syncs Aurasell (powers the "Refresh Aurasell" button)
AURASELL_SYNC_TASK_URL=

# Otter (per-person connection; see README "Otter")
OTTER_API_BASE_URL=

# Vercel Cron sends this as a Bearer token; set the same value in Vercel env
CRON_SECRET=

# Public URL of the app (used in Slack links)
APP_URL=http://localhost:3000
